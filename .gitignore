datasets
# The registry contains versioned metadata and documentation, not raw datasets.
!/docs/datasets/
!/docs/datasets/**
machine.local.yaml
/data/
/tmp/
log
lightning_logs
checkpoints
# Output is local by default. Publish compact reports and summary tables only.
# Gitignore matches paths, not file sizes; review sizes before staging.
/output/**
!/output/**/
!/output/**/README.md
!/output/**/RESULTS.md
!/output/**/tables/*.csv
!/output/**/tables/METRICS.md
# Training history is noisy; publish collected comparison/score tables instead.
/output/**/tables/metrics.csv
# Keep PDF exports local, including uppercase file extensions.
/output/**/*.[pP][dD][fF]
# Keep only the frozen metric contract from each run's technical directory.
/output/**/technical/**
!/output/**/technical/metric-contract.json
# These operational/generated trees never belong in a results publication.
/output/maintenance/
/output/registry/
/output/synthetic_data/
/output/temporal_cache/
outputs
spd_modelnet_experiments
wandb
.claude
